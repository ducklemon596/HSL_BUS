# Environment configuration template
# Copy this file to .env and set the actual values

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TIMEOUT=60

# ============================================
# MQTT CONFIGURATION (HSL Real-time API)
# ============================================
MQTT_BROKER=mqtt.hsl.fi
MQTT_PORT=8883
MQTT_TOPIC=/hfp/v2/journey/ongoing/vp/bus/#
MQTT_USERNAME=
MQTT_PASSWORD=

# ============================================
# KAFKA CONFIGURATION
# ============================================
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=hsl_bus

# ============================================
# GOOGLE CLOUD PUB/SUB CONFIGURATION
# ============================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_SUBSCRIPTION_ID=your-subscription-id

# ============================================
# SPARK CONFIGURATION
# ============================================
SPARK_CHECKPOINT_PATH=/tmp/spark-checkpoints/
SPARK_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============================================
# FLASK WEB SERVER CONFIGURATION
# ============================================
FLASK_DEBUG=True
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=10

# ============================================
# GEOGRAPHIC DATA VALIDATION (Helsinki Area)
# ============================================
LOCATION_LAT_MIN=60.0
LOCATION_LAT_MAX=60.5
LOCATION_LONG_MIN=24.5
LOCATION_LONG_MAX=25.5

# ============================================
# SPEED VALIDATION (in m/s)
# ============================================
MAX_SPEED=33.3
MIN_SPEED=0

# ============================================
# DIRECTION VALIDATION (in degrees)
# ============================================
MIN_HEADING=0
MAX_HEADING=360
