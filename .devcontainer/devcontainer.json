{
    "name": "Spark Lab Environment",
    "dockerComposeFile": ["../docker/docker-compose.yml"],
    "service": "spark_worker",
    "runServices": ["spark_worker", "kafka", "redis", "app"],
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3"
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "tamasfe.even-better-toml"
            ]
        }
    }
}